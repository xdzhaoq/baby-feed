<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youyou.nursing.mapper.NcKnowledgeMapper">

    <resultMap id="KbResult" type="com.youyou.nursing.domain.NcKnowledge">
        <id     property="kbId"      column="kb_id"/>
        <result property="category"  column="category"/>
        <result property="title"     column="title"/>
        <result property="urgency"   column="urgency"/>
        <result property="keywords"  column="keywords"/>
        <result property="content"   column="content"/>
        <result property="sortNum"   column="sort_num"/>
        <result property="status"    column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectList" parameterType="com.youyou.nursing.domain.NcKnowledge" resultMap="KbResult">
        select kb_id, category, title, urgency, keywords, content, sort_num, status, create_time, update_time
          from nc_knowledge
        <where>
            status = '0'
            <if test="category != null and category != ''">and category = #{category}</if>
            <if test="searchValue != null and searchValue != ''">
                and (title like concat('%', #{searchValue}, '%')
                  or keywords like concat('%', #{searchValue}, '%')
                  or content like concat('%', #{searchValue}, '%'))
            </if>
        </where>
        order by sort_num, kb_id
    </select>

    <select id="selectById" resultMap="KbResult">
        select kb_id, category, title, urgency, keywords, content, sort_num, status, create_time, update_time
          from nc_knowledge
         where kb_id = #{kbId} and status = '0'
    </select>
</mapper>
